# Apenas para desenvolvimento local. Troque a senha administrativa antes de iniciar.
MARIADB_DATABASE=orange
MARIADB_USER=orange
MARIADB_PASSWORD=orange_dev_password
MARIADB_ROOT_PASSWORD=orange_root_dev_password
MARIADB_PORT=3307

FRONTEND_PORT=3000
API_PORT=4000

# Opcional: 64 caracteres hexadecimais (32 bytes). Vazio usa uma chave derivada do DATABASE_URL local.
MFA_ENCRYPTION_KEY=

# Obrigatorio para iniciar a API. Cada senha deve ter pelo menos 16 caracteres.
SEED_ADMIN_USERS='[{"email":"admin@example.test","password":"troque-esta-senha-local-123"}]'

# SMTP e OAuth sao opcionais no ambiente local.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
