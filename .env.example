# Variáveis públicas do frontend (root). São lidas no BUILD e embutidas nos
# arquivos de out/. Copie para .env.local (dev) ou .env.production.local (build
# de produção) e preencha. Nunca coloque segredos aqui: tudo vira público.

# Origem da API PHP
NEXT_PUBLIC_BACKEND_URL=https://api-app.bebaorange.com

# Medição (deixe vazio para não carregar nada)
# Meta Pixel: Gerenciador de Eventos da Meta > Fontes de dados > ID do pixel (só números)
NEXT_PUBLIC_META_PIXEL_ID=
# GA4: Administrador > Fluxos de dados > Web > ID da métrica (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
