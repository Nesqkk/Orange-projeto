# API
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
# Chave estavel de 32 bytes em hex ou Base64. Se omitida, deriva de DATABASE_URL.
MFA_ENCRYPTION_KEY=
# SMTP para enviar links de redefinicao; sem essas variaveis o envio nao ocorre.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OAuth: cadastre como redirect URI exatamente FRONTEND_URL + estes caminhos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Conteudo da chave .p8; represente quebras de linha com \n.
APPLE_PRIVATE_KEY=

# Hostinger Web/Cloud: use o nome completo do banco/usuário com o prefixo do hPanel
# e 127.0.0.1 como host. Em desenvolvimento, adapte as credenciais locais.
DATABASE_URL="mysql://orange_user:change_me@127.0.0.1:3306/orange_db"

# Contas administrativas iniciais. Usadas apenas pelo comando db:seed.
# Cada senha deve ter ao menos 16 caracteres e ficar em secrets do provedor.
SEED_ADMIN_USERS='[{"email":"admin@example.com","password":"replace-with-a-unique-password-of-at-least-16-characters"}]'
